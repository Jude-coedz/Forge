# Forge uses Ollama locally so development can run without paid API calls.
# Pull the default model with: ollama pull qwen3:8b
VITE_OLLAMA_MODEL=qwen3:8b

# During `npm run dev`, Vite proxies /ollama to http://127.0.0.1:11434.
# Only override this when using another compatible Ollama endpoint.
# VITE_OLLAMA_URL=/ollama/api/chat
